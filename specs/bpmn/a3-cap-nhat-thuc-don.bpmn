      <bpmn:lane id="Lane_cc" name="Phần mềm CukCuk"><bpmn:flowNodeRef>Task_sync</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_off</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_pause</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_hours</bpmn:flowNodeRef><bpmn:flowNodeRef>End_done</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_spf" name="ShopeeFood"><bpmn:flowNodeRef>Task_apply</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Muốn thay đổi việc bán trên ShopeeFood"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:exclusiveGateway id="GW_type" name="Thay đổi gì?"><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing><bpmn:outgoing>F3</bpmn:outgoing><bpmn:outgoing>F4</bpmn:outgoing><bpmn:outgoing>F5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_edit" name="Sửa món / giá trong thực đơn quán"><bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F6</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_sync" name="Đẩy thay đổi lên"><bpmn:incoming>F6</bpmn:incoming><bpmn:outgoing>F7</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_off" name="Tắt món hết hàng trên ShopeeFood"><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F8</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_pause" name="Tạm ngừng nhận đơn ngay (nghỉ / hết nguyên liệu)"><bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F9</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_hours" name="Cập nhật giờ mở – đóng cửa"><bpmn:incoming>F5</bpmn:incoming><bpmn:outgoing>F10</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_apply" name="Cập nhật gian hàng"><bpmn:incoming>F7</bpmn:incoming><bpmn:incoming>F8</bpmn:incoming><bpmn:incoming>F9</bpmn:incoming><bpmn:incoming>F10</bpmn:incoming><bpmn:outgoing>F11</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_done" name="Đã cập nhật lên ShopeeFood"><bpmn:incoming>F11</bpmn:incoming></bpmn:endEvent>
