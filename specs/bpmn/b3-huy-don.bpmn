<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Def_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="B3 · Hủy đơn (theo thời điểm)" processRef="Process_b3"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_b3" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_cc" name="Phần mềm CukCuk"><bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_picked</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_staff" name="Nhân viên"><bpmn:flowNodeRef>End_no</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_printed</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_slip</bpmn:flowNodeRef><bpmn:flowNodeRef>End_cancel</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Có yêu cầu hủy đơn (quán / khách / ShopeeFood)"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:exclusiveGateway id="GW_picked" name="Tài xế đã lấy hàng chưa?"><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing><bpmn:outgoing>F3</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_no" name="Không hủy được — báo nhân viên"><bpmn:incoming>F2</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="GW_printed" name="Bếp đã in tem chưa?"><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing><bpmn:outgoing>F6</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_slip" name="In phiếu báo hủy cho bếp"><bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F5</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_cancel" name="Đơn chuyển sang mục Hủy"><bpmn:incoming>F5</bpmn:incoming><bpmn:incoming>F6</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" name="" sourceRef="Start_1" targetRef="GW_picked"/>
    <bpmn:sequenceFlow id="F2" name="Đã lấy hàng" sourceRef="GW_picked" targetRef="End_no"/>
    <bpmn:sequenceFlow id="F3" name="Chưa lấy hàng" sourceRef="GW_picked" targetRef="GW_printed"/>
    <bpmn:sequenceFlow id="F4" name="Đã in tem bếp" sourceRef="GW_printed" targetRef="Task_slip"/>
    <bpmn:sequenceFlow id="F5" name="" sourceRef="Task_slip" targetRef="End_cancel"/>
    <bpmn:sequenceFlow id="F6" name="Chưa in" sourceRef="GW_printed" targetRef="End_cancel"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape bpmnElement="Participant_1" isHorizontal="false"><dc:Bounds x="0" y="0" width="690" height="680"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Lane_cc" isHorizontal="false"><dc:Bounds x="0" y="30" width="250" height="650"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Lane_staff" isHorizontal="false"><dc:Bounds x="250" y="30" width="440" height="650"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Start_1"><dc:Bounds x="107" y="92" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="0" y="82" width="99" height="56"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="GW_picked"><dc:Bounds x="100" y="205" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="0" y="215" width="92" height="30"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="End_no"><dc:Bounds x="357" y="332" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="250" y="335" width="99" height="30"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="GW_printed"><dc:Bounds x="540" y="325" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="404" y="342" width="128" height="17"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_slip"><dc:Bounds x="310" y="435" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="End_cancel"><dc:Bounds x="357" y="572" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="250" y="575" width="99" height="30"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge bpmnElement="F1"><di:waypoint x="125" y="128"/><di:waypoint x="125" y="205"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="F2"><di:waypoint x="125" y="255"/><di:waypoint x="125" y="294"/><di:waypoint x="375" y="294"/><di:waypoint x="375" y="332"/><bpmndi:BPMNLabel><dc:Bounds x="133" y="287" width="68" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="F3"><di:waypoint x="150" y="230"/><di:waypoint x="170" y="230"/><di:waypoint x="170" y="305"/><di:waypoint x="565" y="305"/><di:waypoint x="565" y="325"/><bpmndi:BPMNLabel><dc:Bounds x="178" y="223" width="81" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="F4"><di:waypoint x="565" y="375"/><di:waypoint x="565" y="405"/><di:waypoint x="375" y="405"/><di:waypoint x="375" y="435"/><bpmndi:BPMNLabel><dc:Bounds x="573" y="398" width="81" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="F5"><di:waypoint x="375" y="505"/><di:waypoint x="375" y="539"/><di:waypoint x="367" y="539"/><di:waypoint x="367" y="572"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="F6"><di:waypoint x="540" y="350"/><di:waypoint x="520" y="350"/><di:waypoint x="520" y="552"/><di:waypoint x="383" y="552"/><di:waypoint x="383" y="572"/><bpmndi:BPMNLabel><dc:Bounds x="498" y="328" width="43" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>