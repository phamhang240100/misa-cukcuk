<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Def_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Tổng quan tích hợp CukCuk ↔ ShopeeFood — từ kết nối đến xử lý đơn tại POS" processRef="Process_tong_quan_tich_hop"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_tong_quan_tich_hop" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_owner" name="Chủ quán"><bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_connect</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_scan</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_map</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_hours</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_pos" name="Nhân viên POS"><bpmn:flowNodeRef>Task_poshow</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_handle</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_reject</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_confirm</bpmn:flowNodeRef><bpmn:flowNodeRef>End_done</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_cukcuk" name="Hệ thống CukCuk"><bpmn:flowNodeRef>Task_qr</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_savetoken</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_conn</bpmn:flowNodeRef><bpmn:flowNodeRef>End_connfail</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_sync</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_getdetail</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_sendcancel</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_sendconfirm</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_settle</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_spf" name="ShopeeFood"><bpmn:flowNodeRef>Task_token</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_spfmenu</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_webhook</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_driver</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_customer" name="Khách hàng &amp; Tài xế"><bpmn:flowNodeRef>Task_order</bpmn:flowNodeRef><bpmn:flowNodeRef>End_cancel</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_deliver</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Chủ quán muốn bán trên ShopeeFood"><bpmn:outgoing>Flow_start</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Task_connect" name="Bấm Kết nối ShopeeFood trên CukCuk"><bpmn:incoming>Flow_start</bpmn:incoming><bpmn:outgoing>Flow_c1</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_qr" name="Sinh mã QR (device-code)"><bpmn:incoming>Flow_c1</bpmn:incoming><bpmn:outgoing>Flow_c2</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_scan" name="Quét QR &amp; xác nhận trên Shopee Partner App"><bpmn:incoming>Flow_c2</bpmn:incoming><bpmn:outgoing>Flow_c3</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_token" name="Xác thực chủ quán &amp; trả token"><bpmn:incoming>Flow_c3</bpmn:incoming><bpmn:outgoing>Flow_c4</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_savetoken" name="Lưu token theo cửa hàng (mapping 1:1)"><bpmn:incoming>Flow_c4</bpmn:incoming><bpmn:outgoing>Flow_c5</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_conn" name="Kết nối thành công?"><bpmn:incoming>Flow_c5</bpmn:incoming><bpmn:outgoing>Flow_conn_no</bpmn:outgoing><bpmn:outgoing>Flow_conn_yes</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_connfail" name="Kết nối thất bại (thử lại)"><bpmn:incoming>Flow_conn_no</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="Task_map" name="Mapping món/nhóm/topping (gợi ý tự động)"><bpmn:incoming>Flow_conn_yes</bpmn:incoming><bpmn:outgoing>Flow_m1</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_sync" name="Đồng bộ menu 1 chiều lên ShopeeFood"><bpmn:incoming>Flow_m1</bpmn:incoming><bpmn:outgoing>Flow_m2</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_spfmenu" name="Cập nhật thực đơn gian hàng"><bpmn:incoming>Flow_m2</bpmn:incoming><bpmn:outgoing>Flow_m3</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_hours" name="Thiết lập giờ hoạt động &amp; giá bán"><bpmn:incoming>Flow_m3</bpmn:incoming><bpmn:outgoing>Flow_m4</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_order" name="Khách đặt món &amp; thanh toán trên ShopeeFood"><bpmn:incoming>Flow_m4</bpmn:incoming><bpmn:outgoing>Flow_o1</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_webhook" name="Gửi webhook báo đơn mới"><bpmn:incoming>Flow_o1</bpmn:incoming><bpmn:outgoing>Flow_o2</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_getdetail" name="Ack 200 &amp; lấy chi tiết đơn (get_details)"><bpmn:incoming>Flow_o2</bpmn:incoming><bpmn:outgoing>Flow_o3</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_poshow" name="Đơn vào tab Chưa xác nhận + thông báo"><bpmn:incoming>Flow_o3</bpmn:incoming><bpmn:outgoing>Flow_o4</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_handle" name="Nhân viên xử lý đơn?"><bpmn:incoming>Flow_o4</bpmn:incoming><bpmn:outgoing>Flow_h_no</bpmn:outgoing><bpmn:outgoing>Flow_h_yes</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_reject" name="Từ chối kèm lý do"><bpmn:incoming>Flow_h_no</bpmn:incoming><bpmn:outgoing>Flow_r1</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_sendcancel" name="Báo hủy đơn lên ShopeeFood"><bpmn:incoming>Flow_r1</bpmn:incoming><bpmn:outgoing>Flow_r2</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_cancel" name="Đơn bị hủy (dừng)"><bpmn:incoming>Flow_r2</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="Task_confirm" name="Xác nhận đơn → gửi bếp &amp; in tem"><bpmn:incoming>Flow_h_yes</bpmn:incoming><bpmn:outgoing>Flow_p1</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_sendconfirm" name="Cập nhật trạng thái xác nhận lên ShopeeFood"><bpmn:incoming>Flow_p1</bpmn:incoming><bpmn:outgoing>Flow_p2</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_driver" name="Điều phối tài xế"><bpmn:incoming>Flow_p2</bpmn:incoming><bpmn:outgoing>Flow_p3</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_deliver" name="Tài xế lấy hàng &amp; giao cho khách"><bpmn:incoming>Flow_p3</bpmn:incoming><bpmn:outgoing>Flow_p4</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_settle" name="Ghi nhận doanh thu &amp; đối soát (commission, thuế, KM)"><bpmn:incoming>Flow_p4</bpmn:incoming><bpmn:outgoing>Flow_p5</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_done" name="Đơn hoàn thành"><bpmn:incoming>Flow_p5</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_start" name="" sourceRef="Start_1" targetRef="Task_connect"/>
    <bpmn:sequenceFlow id="Flow_c1" name="" sourceRef="Task_connect" targetRef="Task_qr"/>
    <bpmn:sequenceFlow id="Flow_c2" name="" sourceRef="Task_qr" targetRef="Task_scan"/>
    <bpmn:sequenceFlow id="Flow_c3" name="" sourceRef="Task_scan" targetRef="Task_token"/>
    <bpmn:sequenceFlow id="Flow_c4" name="" sourceRef="Task_token" targetRef="Task_savetoken"/>
    <bpmn:sequenceFlow id="Flow_c5" name="" sourceRef="Task_savetoken" targetRef="GW_conn"/>
    <bpmn:sequenceFlow id="Flow_conn_no" name="Thất bại" sourceRef="GW_conn" targetRef="End_connfail"/>
    <bpmn:sequenceFlow id="Flow_conn_yes" name="Thành công" sourceRef="GW_conn" targetRef="Task_map"/>
    <bpmn:sequenceFlow id="Flow_m1" name="" sourceRef="Task_map" targetRef="Task_sync"/>
    <bpmn:sequenceFlow id="Flow_m2" name="" sourceRef="Task_sync" targetRef="Task_spfmenu"/>
    <bpmn:sequenceFlow id="Flow_m3" name="" sourceRef="Task_spfmenu" targetRef="Task_hours"/>
    <bpmn:sequenceFlow id="Flow_m4" name="" sourceRef="Task_hours" targetRef="Task_order"/>
    <bpmn:sequenceFlow id="Flow_o1" name="" sourceRef="Task_order" targetRef="Task_webhook"/>
    <bpmn:sequenceFlow id="Flow_o2" name="" sourceRef="Task_webhook" targetRef="Task_getdetail"/>
    <bpmn:sequenceFlow id="Flow_o3" name="" sourceRef="Task_getdetail" targetRef="Task_poshow"/>
    <bpmn:sequenceFlow id="Flow_o4" name="" sourceRef="Task_poshow" targetRef="GW_handle"/>
    <bpmn:sequenceFlow id="Flow_h_no" name="Từ chối" sourceRef="GW_handle" targetRef="Task_reject"/>
    <bpmn:sequenceFlow id="Flow_r1" name="" sourceRef="Task_reject" targetRef="Task_sendcancel"/>
    <bpmn:sequenceFlow id="Flow_r2" name="" sourceRef="Task_sendcancel" targetRef="End_cancel"/>
    <bpmn:sequenceFlow id="Flow_h_yes" name="Xác nhận" sourceRef="GW_handle" targetRef="Task_confirm"/>
    <bpmn:sequenceFlow id="Flow_p1" name="" sourceRef="Task_confirm" targetRef="Task_sendconfirm"/>
    <bpmn:sequenceFlow id="Flow_p2" name="" sourceRef="Task_sendconfirm" targetRef="Task_driver"/>
    <bpmn:sequenceFlow id="Flow_p3" name="" sourceRef="Task_driver" targetRef="Task_deliver"/>
    <bpmn:sequenceFlow id="Flow_p4" name="" sourceRef="Task_deliver" targetRef="Task_settle"/>
    <bpmn:sequenceFlow id="Flow_p5" name="" sourceRef="Task_settle" targetRef="End_done"/>
  </bpmn:process>
