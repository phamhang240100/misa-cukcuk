<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Def_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="A1 · Kết nối cửa hàng với ShopeeFood" processRef="Process_a1"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_a1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_owner" name="Chủ quán"><bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_scan</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_cc" name="Phần mềm CukCuk"><bpmn:flowNodeRef>GW_pre</bpmn:flowNodeRef><bpmn:flowNodeRef>End_block</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_qr</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_result</bpmn:flowNodeRef><bpmn:flowNodeRef>End_fail</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_done</bpmn:flowNodeRef><bpmn:flowNodeRef>End_ok</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_spf" name="ShopeeFood"><bpmn:flowNodeRef>Task_check</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Bấm &quot;Kết nối ShopeeFood&quot;"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:exclusiveGateway id="GW_pre" name="Đủ điều kiện kết nối?"><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing><bpmn:outgoing>F3</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_block" name="Chưa kết nối được — cần đăng ký gian hàng ShopeeFood trước"><bpmn:incoming>F2</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="Task_qr" name="Hiện mã QR (có đếm giờ)"><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_scan" name="Quét QR, đăng nhập tài khoản ShopeeFood, bấm Xác nhận"><bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F5</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_check" name="Kiểm tra &amp; đồng ý kết nối"><bpmn:incoming>F5</bpmn:incoming><bpmn:outgoing>F6</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_result" name="Kết nối được không?"><bpmn:incoming>F6</bpmn:incoming><bpmn:outgoing>F7</bpmn:outgoing><bpmn:outgoing>F8</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_fail" name="Chưa kết nối được — bấm tạo mã mới"><bpmn:incoming>F7</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="Task_done" name="Lưu kết nối, hiện tên quán"><bpmn:incoming>F8</bpmn:incoming><bpmn:outgoing>F9</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_ok" name="Đã kết nối"><bpmn:incoming>F9</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" name="" sourceRef="Start_1" targetRef="GW_pre"/>
    <bpmn:sequenceFlow id="F2" name="Chưa có gian hàng / không phải chủ tài khoản" sourceRef="GW_pre" targetRef="End_block"/>
    <bpmn:sequenceFlow id="F3" name="Đủ điều kiện" sourceRef="GW_pre" targetRef="Task_qr"/>
    <bpmn:sequenceFlow id="F4" name="" sourceRef="Task_qr" targetRef="Task_scan"/>
    <bpmn:sequenceFlow id="F5" name="" sourceRef="Task_scan" targetRef="Task_check"/>
    <bpmn:sequenceFlow id="F6" name="" sourceRef="Task_check" targetRef="GW_result"/>
    <bpmn:sequenceFlow id="F7" name="Mã hết hạn / quét nhầm / từ chối" sourceRef="GW_result" targetRef="End_fail"/>
    <bpmn:sequenceFlow id="F8" name="Thành công" sourceRef="GW_result" targetRef="Task_done"/>
    <bpmn:sequenceFlow id="F9" name="" sourceRef="Task_done" targetRef="End_ok"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape bpmnElement="Participant_1" isHorizontal="false"><dc:Bounds x="0" y="0" width="940" height="1040"/></bpmndi:BPMNShape>
