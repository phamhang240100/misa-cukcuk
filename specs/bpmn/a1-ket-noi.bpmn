      <bpmndi:BPMNShape bpmnElement="Lane_spf" isHorizontal="false"><dc:Bounds x="690" y="30" width="250" height="1010"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Start_1"><dc:Bounds x="107" y="92" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="0" y="95" width="99" height="30"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="GW_pre"><dc:Bounds x="350" y="205" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="250" y="215" width="92" height="30"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="End_block"><dc:Bounds x="357" y="332" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="250" y="322" width="99" height="56"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_qr"><dc:Bounds x="500" y="315" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_scan"><dc:Bounds x="60" y="435" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_check"><dc:Bounds x="750" y="555" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="GW_result"><dc:Bounds x="350" y="685" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="250" y="695" width="92" height="30"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="End_fail"><dc:Bounds x="357" y="812" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="250" y="809" width="99" height="43"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_done"><dc:Bounds x="500" y="795" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="End_ok"><dc:Bounds x="357" y="932" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="250" y="942" width="99" height="17"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge bpmnElement="F1"><di:waypoint x="125" y="128"/><di:waypoint x="125" y="167"/><di:waypoint x="375" y="167"/><di:waypoint x="375" y="205"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="F2"><di:waypoint x="375" y="255"/><di:waypoint x="375" y="332"/><bpmndi:BPMNLabel><dc:Bounds x="383" y="278" width="160" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="F3"><di:waypoint x="400" y="230"/><di:waypoint x="420" y="230"/><di:waypoint x="420" y="295"/><di:waypoint x="565" y="295"/><di:waypoint x="565" y="315"/><bpmndi:BPMNLabel><dc:Bounds x="428" y="223" width="74" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="F4"><di:waypoint x="565" y="385"/><di:waypoint x="565" y="410"/><di:waypoint x="125" y="410"/><di:waypoint x="125" y="435"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="F5"><di:waypoint x="125" y="505"/><di:waypoint x="125" y="530"/><di:waypoint x="815" y="530"/><di:waypoint x="815" y="555"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="F6"><di:waypoint x="815" y="625"/><di:waypoint x="815" y="655"/><di:waypoint x="375" y="655"/><di:waypoint x="375" y="685"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="F7"><di:waypoint x="375" y="735"/><di:waypoint x="375" y="812"/><bpmndi:BPMNLabel><dc:Bounds x="383" y="758" width="160" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="F8"><di:waypoint x="400" y="710"/><di:waypoint x="420" y="710"/><di:waypoint x="420" y="775"/><di:waypoint x="565" y="775"/><di:waypoint x="565" y="795"/><bpmndi:BPMNLabel><dc:Bounds x="428" y="703" width="62" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="F9"><di:waypoint x="565" y="865"/><di:waypoint x="565" y="899"/><di:waypoint x="375" y="899"/><di:waypoint x="375" y="932"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
