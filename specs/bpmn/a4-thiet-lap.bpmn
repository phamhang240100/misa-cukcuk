<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Def_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="A4 · Thiết lập tùy chọn bán hàng (cấu hình)" processRef="Process_a4"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_a4" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_owner" name="Chủ quán"><bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_hours</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_auto</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_bill</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_slip</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_cc" name="Phần mềm CukCuk"><bpmn:flowNodeRef>Task_save</bpmn:flowNodeRef><bpmn:flowNodeRef>End_ok</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Mở màn Thiết lập ShopeeFood"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Task_hours" name="Đặt giờ mở – đóng cửa &amp; ngày nghỉ lễ"><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_auto" name="Chọn cách xác nhận đơn: nhân viên tự bấm / tự động tất cả / tự động chỉ đơn đã trả (kèm tự xác nhận sau 2 phút)"><bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_bill" name="Chọn tự in tạm tính: khi xác nhận / khi gửi bếp / tắt"><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_slip" name="Bật / tắt in phiếu bàn giao cho tài xế"><bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F5</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_save" name="Lưu thiết lập"><bpmn:incoming>F5</bpmn:incoming><bpmn:outgoing>F6</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_ok" name="Đã lưu — áp dụng cho các đơn sau"><bpmn:incoming>F6</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" name="" sourceRef="Start_1" targetRef="Task_hours"/>
    <bpmn:sequenceFlow id="F2" name="" sourceRef="Task_hours" targetRef="Task_auto"/>
    <bpmn:sequenceFlow id="F3" name="" sourceRef="Task_auto" targetRef="Task_bill"/>
    <bpmn:sequenceFlow id="F4" name="" sourceRef="Task_bill" targetRef="Task_slip"/>
    <bpmn:sequenceFlow id="F5" name="" sourceRef="Task_slip" targetRef="Task_save"/>
    <bpmn:sequenceFlow id="F6" name="" sourceRef="Task_save" targetRef="End_ok"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape bpmnElement="Participant_1" isHorizontal="false"><dc:Bounds x="0" y="0" width="500" height="920"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Lane_owner" isHorizontal="false"><dc:Bounds x="0" y="30" width="250" height="890"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Lane_cc" isHorizontal="false"><dc:Bounds x="250" y="30" width="250" height="890"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Start_1"><dc:Bounds x="107" y="92" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="0" y="95" width="99" height="30"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_hours"><dc:Bounds x="60" y="195" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_auto"><dc:Bounds x="60" y="315" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_bill"><dc:Bounds x="60" y="435" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_slip"><dc:Bounds x="60" y="555" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_save"><dc:Bounds x="310" y="675" width="130" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="End_ok"><dc:Bounds x="357" y="812" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="250" y="809" width="99" height="43"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge bpmnElement="F1"><di:waypoint x="125" y="128"/><di:waypoint x="125" y="195"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="F2"><di:waypoint x="125" y="265"/><di:waypoint x="125" y="315"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="F3"><di:waypoint x="125" y="385"/><di:waypoint x="125" y="435"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="F4"><di:waypoint x="125" y="505"/><di:waypoint x="125" y="555"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="F5"><di:waypoint x="125" y="625"/><di:waypoint x="125" y="650"/><di:waypoint x="375" y="650"/><di:waypoint x="375" y="675"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="F6"><di:waypoint x="375" y="745"/><di:waypoint x="375" y="812"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>