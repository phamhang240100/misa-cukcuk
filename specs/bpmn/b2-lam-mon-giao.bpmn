      <bpmndi:BPMNShape bpmnElement="Start_1"><dc:Bounds x="107" y="92" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="0" y="102" width="99" height="17"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
