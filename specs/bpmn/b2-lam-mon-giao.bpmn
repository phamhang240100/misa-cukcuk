<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Def_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="B2 · Làm món → Giao hàng → Hoàn thành" processRef="Process_b2"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_b2" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_staff" name="Nhân viên"><bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_kitchen</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_stock</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_oos</bpmn:flowNodeRef><bpmn:flowNodeRef>End_oos</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ready</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_slip</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_self</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_spf" name="ShopeeFood"><bpmn:flowNodeRef>GW_ship</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_assign</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_delivered</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_driver" name="Tài xế / Khách"><bpmn:flowNodeRef>Task_pickup</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_deliver</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_cc" name="Phần mềm CukCuk"><bpmn:flowNodeRef>Task_complete</bpmn:flowNodeRef><bpmn:flowNodeRef>End_done</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Đơn đã xác nhận"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Task_kitchen" name="In tem chế biến + gửi bếp / bar"><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_stock" name="Đủ món để làm không?"><bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing><bpmn:outgoing>F5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_oos" name="Hết món → báo khách rồi hủy đơn"><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_oos" name="Đơn hủy do hết món"><bpmn:incoming>F4</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="Task_ready" name="Báo món đã xong"><bpmn:incoming>F5</bpmn:incoming><bpmn:outgoing>F6</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_ship" name="Cách giao?"><bpmn:incoming>F6</bpmn:incoming><bpmn:outgoing>F7</bpmn:outgoing><bpmn:outgoing>F12</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_assign" name="Điều tài xế tới lấy"><bpmn:incoming>F7</bpmn:incoming><bpmn:outgoing>F8</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_pickup" name="Tài xế tới lấy, đối chiếu mã đơn rút gọn + món"><bpmn:incoming>F8</bpmn:incoming><bpmn:outgoing>F9</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_slip" name="In phiếu bàn giao (nếu bật) + giao túi cho tài xế"><bpmn:incoming>F9</bpmn:incoming><bpmn:outgoing>F10</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_deliver" name="Giao hàng cho khách"><bpmn:incoming>F10</bpmn:incoming><bpmn:outgoing>F11</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_self" name="Khách tự đến lấy: đối chiếu mã với khách, giao tận tay"><bpmn:incoming>F12</bpmn:incoming><bpmn:outgoing>F13</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_delivered" name="ShopeeFood báo đã giao xong"><bpmn:incoming>F11</bpmn:incoming><bpmn:incoming>F13</bpmn:incoming><bpmn:outgoing>F14</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_complete" name="In hóa đơn + ghi nhận doanh thu; xem tiền ShopeeFood trả về"><bpmn:incoming>F14</bpmn:incoming><bpmn:outgoing>F15</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_done" name="Đơn hoàn thành"><bpmn:incoming>F15</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" name="" sourceRef="Start_1" targetRef="Task_kitchen"/>
    <bpmn:sequenceFlow id="F2" name="" sourceRef="Task_kitchen" targetRef="GW_stock"/>
    <bpmn:sequenceFlow id="F3" name="Hết món" sourceRef="GW_stock" targetRef="Task_oos"/>
    <bpmn:sequenceFlow id="F4" name="" sourceRef="Task_oos" targetRef="End_oos"/>
    <bpmn:sequenceFlow id="F5" name="Đủ món" sourceRef="GW_stock" targetRef="Task_ready"/>
    <bpmn:sequenceFlow id="F6" name="" sourceRef="Task_ready" targetRef="GW_ship"/>
    <bpmn:sequenceFlow id="F7" name="Tài xế giao" sourceRef="GW_ship" targetRef="Task_assign"/>
    <bpmn:sequenceFlow id="F8" name="" sourceRef="Task_assign" targetRef="Task_pickup"/>
    <bpmn:sequenceFlow id="F9" name="" sourceRef="Task_pickup" targetRef="Task_slip"/>
    <bpmn:sequenceFlow id="F10" name="" sourceRef="Task_slip" targetRef="Task_deliver"/>
    <bpmn:sequenceFlow id="F11" name="" sourceRef="Task_deliver" targetRef="Task_delivered"/>
    <bpmn:sequenceFlow id="F12" name="Khách tự đến lấy" sourceRef="GW_ship" targetRef="Task_self"/>
    <bpmn:sequenceFlow id="F13" name="" sourceRef="Task_self" targetRef="Task_delivered"/>
    <bpmn:sequenceFlow id="F14" name="" sourceRef="Task_delivered" targetRef="Task_complete"/>
    <bpmn:sequenceFlow id="F15" name="" sourceRef="Task_complete" targetRef="End_done"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape bpmnElement="Participant_1" isHorizontal="false"><dc:Bounds x="0" y="0" width="1190" height="1520"/></bpmndi:BPMNShape>
