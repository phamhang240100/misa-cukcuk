{
  "process": { "id": "Process_tong_quan_tich_hop", "title": "Tổng quan tích hợp CukCuk ↔ ShopeeFood — từ kết nối đến xử lý đơn tại POS" },
  "lanes": [
    { "id": "Lane_owner",    "name": "Chủ quán" },
    { "id": "Lane_pos",      "name": "Nhân viên POS" },
    { "id": "Lane_cukcuk",   "name": "Hệ thống CukCuk" },
    { "id": "Lane_spf",      "name": "ShopeeFood" },
    { "id": "Lane_customer", "name": "Khách hàng & Tài xế" }
  ],
  "nodes": [
    { "id": "Start_1",          "kind": "start",   "lane": "Lane_owner",    "name": "Chủ quán muốn bán trên ShopeeFood" },

    { "id": "Task_connect",     "kind": "task",    "lane": "Lane_owner",    "name": "Bấm Kết nối ShopeeFood trên CukCuk" },
    { "id": "Task_qr",          "kind": "task",    "lane": "Lane_cukcuk",   "name": "Sinh mã QR (device-code)" },
    { "id": "Task_scan",        "kind": "task",    "lane": "Lane_owner",    "name": "Quét QR & xác nhận trên Shopee Partner App" },
    { "id": "Task_token",       "kind": "task",    "lane": "Lane_spf",      "name": "Xác thực chủ quán & trả token" },
    { "id": "Task_savetoken",   "kind": "task",    "lane": "Lane_cukcuk",   "name": "Lưu token theo cửa hàng (mapping 1:1)" },
    { "id": "GW_conn",          "kind": "gateway", "lane": "Lane_cukcuk",   "name": "Kết nối thành công?" },
    { "id": "End_connfail",     "kind": "end",     "lane": "Lane_cukcuk",   "name": "Kết nối thất bại (thử lại)" },

    { "id": "Task_map",         "kind": "task",    "lane": "Lane_owner",    "name": "Mapping món/nhóm/topping (gợi ý tự động)" },
    { "id": "Task_sync",        "kind": "task",    "lane": "Lane_cukcuk",   "name": "Đồng bộ menu 1 chiều lên ShopeeFood" },
    { "id": "Task_spfmenu",     "kind": "task",    "lane": "Lane_spf",      "name": "Cập nhật thực đơn gian hàng" },
    { "id": "Task_hours",       "kind": "task",    "lane": "Lane_owner",    "name": "Thiết lập giờ hoạt động & giá bán" },

    { "id": "Task_order",       "kind": "task",    "lane": "Lane_customer", "name": "Khách đặt món & thanh toán trên ShopeeFood" },
    { "id": "Task_webhook",     "kind": "task",    "lane": "Lane_spf",      "name": "Gửi webhook báo đơn mới" },
    { "id": "Task_getdetail",   "kind": "task",    "lane": "Lane_cukcuk",   "name": "Ack 200 & lấy chi tiết đơn (get_details)" },
    { "id": "Task_poshow",      "kind": "task",    "lane": "Lane_pos",      "name": "Đơn vào tab Chưa xác nhận + thông báo" },
    { "id": "GW_handle",        "kind": "gateway", "lane": "Lane_pos",      "name": "Nhân viên xử lý đơn?" },

    { "id": "Task_reject",      "kind": "task",    "lane": "Lane_pos",      "name": "Từ chối kèm lý do" },
    { "id": "Task_sendcancel",  "kind": "task",    "lane": "Lane_cukcuk",   "name": "Báo hủy đơn lên ShopeeFood" },
    { "id": "End_cancel",       "kind": "end",     "lane": "Lane_customer", "name": "Đơn bị hủy (dừng)" },

    { "id": "Task_confirm",     "kind": "task",    "lane": "Lane_pos",      "name": "Xác nhận đơn → gửi bếp & in tem" },
    { "id": "Task_sendconfirm", "kind": "task",    "lane": "Lane_cukcuk",   "name": "Cập nhật trạng thái xác nhận lên ShopeeFood" },
    { "id": "Task_driver",      "kind": "task",    "lane": "Lane_spf",      "name": "Điều phối tài xế" },
    { "id": "Task_deliver",     "kind": "task",    "lane": "Lane_customer", "name": "Tài xế lấy hàng & giao cho khách" },
    { "id": "Task_settle",      "kind": "task",    "lane": "Lane_cukcuk",   "name": "Ghi nhận doanh thu & đối soát (commission, thuế, KM)" },
    { "id": "End_done",         "kind": "end",     "lane": "Lane_pos",      "name": "Đơn hoàn thành" }
  ],
  "flows": [
    { "id": "Flow_start",     "src": "Start_1",        "tgt": "Task_connect" },
    { "id": "Flow_c1",        "src": "Task_connect",   "tgt": "Task_qr" },
    { "id": "Flow_c2",        "src": "Task_qr",        "tgt": "Task_scan" },
    { "id": "Flow_c3",        "src": "Task_scan",      "tgt": "Task_token" },
    { "id": "Flow_c4",        "src": "Task_token",     "tgt": "Task_savetoken" },
    { "id": "Flow_c5",        "src": "Task_savetoken", "tgt": "GW_conn" },
    { "id": "Flow_conn_no",   "src": "GW_conn",        "tgt": "End_connfail", "name": "Thất bại" },
    { "id": "Flow_conn_yes",  "src": "GW_conn",        "tgt": "Task_map",     "name": "Thành công" },

    { "id": "Flow_m1",        "src": "Task_map",       "tgt": "Task_sync" },
    { "id": "Flow_m2",        "src": "Task_sync",      "tgt": "Task_spfmenu" },
    { "id": "Flow_m3",        "src": "Task_spfmenu",   "tgt": "Task_hours" },
    { "id": "Flow_m4",        "src": "Task_hours",     "tgt": "Task_order" },

    { "id": "Flow_o1",        "src": "Task_order",     "tgt": "Task_webhook" },
    { "id": "Flow_o2",        "src": "Task_webhook",   "tgt": "Task_getdetail" },
    { "id": "Flow_o3",        "src": "Task_getdetail", "tgt": "Task_poshow" },
    { "id": "Flow_o4",        "src": "Task_poshow",    "tgt": "GW_handle" },

    { "id": "Flow_h_no",      "src": "GW_handle",       "tgt": "Task_reject",     "name": "Từ chối" },
    { "id": "Flow_r1",        "src": "Task_reject",     "tgt": "Task_sendcancel" },
    { "id": "Flow_r2",        "src": "Task_sendcancel", "tgt": "End_cancel" },

    { "id": "Flow_h_yes",     "src": "GW_handle",       "tgt": "Task_confirm",     "name": "Xác nhận" },
    { "id": "Flow_p1",        "src": "Task_confirm",     "tgt": "Task_sendconfirm" },
    { "id": "Flow_p2",        "src": "Task_sendconfirm", "tgt": "Task_driver" },
    { "id": "Flow_p3",        "src": "Task_driver",      "tgt": "Task_deliver" },
    { "id": "Flow_p4",        "src": "Task_deliver",     "tgt": "Task_settle" },
    { "id": "Flow_p5",        "src": "Task_settle",      "tgt": "End_done" }
  ]
}
