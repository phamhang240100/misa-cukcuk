<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Def_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Dùng Grab Express trong MISA CukCuk" processRef="Process_grab_express"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_grab_express" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_ql" name="Quản lý nhà hàng"><bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_kb</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_kn</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_kn</bpmn:flowNodeRef><bpmn:flowNodeRef>End_loi</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_dakn</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_rep1</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_rep2</bpmn:flowNodeRef><bpmn:flowNodeRef>End_ok</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_tn" name="Thu ngân (POS)"><bpmn:flowNodeRef>Task_order</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_phi</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_cod</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_cod</bpmn:flowNodeRef><bpmn:flowNodeRef>End_khac</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_cat</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_gui</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_gui</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_theodoi</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_auto</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_ketcuc</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_tt</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_fail</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_nhac</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_moilai</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_xuly</bpmn:flowNodeRef><bpmn:flowNodeRef>End_huy</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_ge" name="Grab Express"><bpmn:flowNodeRef>Task_vd</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_giao</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Bắt đầu"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Task_kb" name="Khai báo thông tin kết nối Grab Express"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_kn" name="Nhấn Kết nối"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_kn" name="Hợp lệ và địa chỉ được Grab phục vụ?"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing><bpmn:outgoing>f5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_loi" name="Báo lỗi, chưa kết nối"><bpmn:incoming>f4</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="Task_dakn" name="Đã kết nối"><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_order" name="Tạo order, chọn giao Grab Express"><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_phi" name="Nhập / sửa Phí GH thu khách"><bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_cod" name="Bấm Lưu: đơn thu hộ, COD tự tính bằng Còn phải thu"><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f8b</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_cod" name="COD trong hạn mức và địa chỉ được Grab phục vụ?"><bpmn:incoming>f8b</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing><bpmn:outgoing>f10</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_khac" name="Chọn đối tác giao hàng khác"><bpmn:incoming>f9</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="Task_cat" name="Đơn ở Chờ gửi đối tác"><bpmn:incoming>f10</bpmn:incoming><bpmn:incoming>f13b</bpmn:incoming><bpmn:incoming>f24</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_gui" name="Gửi đơn hàng"><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f12</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_gui" name="Gửi đơn sang Grab thành công?"><bpmn:incoming>f12</bpmn:incoming><bpmn:outgoing>f13</bpmn:outgoing><bpmn:outgoing>f13b</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_vd" name="Nhận đơn, tạo vận đơn"><bpmn:incoming>f13</bpmn:incoming><bpmn:outgoing>f14</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_giao" name="Điều phối tài xế, lấy hàng và giao"><bpmn:incoming>f14</bpmn:incoming><bpmn:outgoing>f15</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_theodoi" name="Theo dõi trạng thái ở Sổ giao hàng"><bpmn:incoming>f15</bpmn:incoming><bpmn:outgoing>f16</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_auto" name="Đơn tự cập nhật trạng thái giao theo Grab (không cần bấm Giao hàng)"><bpmn:incoming>f16</bpmn:incoming><bpmn:outgoing>f16b</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_ketcuc" name="Giao thành công?"><bpmn:incoming>f16b</bpmn:incoming><bpmn:outgoing>f17</bpmn:outgoing><bpmn:outgoing>f18</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_tt" name="Thu tiền (khi Grab đã giao xong)"><bpmn:incoming>f17</bpmn:incoming><bpmn:outgoing>f21</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_fail" name="Đã lấy hàng rồi hoàn về quán?"><bpmn:incoming>f18</bpmn:incoming><bpmn:outgoing>f19</bpmn:outgoing><bpmn:outgoing>f20</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_nhac" name="Nhắc thu ngân xử lý hàng hoàn (món có thể hỏng)"><bpmn:incoming>f19</bpmn:incoming><bpmn:outgoing>f22</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_moilai" name="Đơn tự quay lại Chờ gửi đối tác"><bpmn:incoming>f20</bpmn:incoming><bpmn:outgoing>f23</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_xuly" name="Thu ngân xử lý thế nào?"><bpmn:incoming>f22</bpmn:incoming><bpmn:incoming>f23</bpmn:incoming><bpmn:outgoing>f24</bpmn:outgoing><bpmn:outgoing>f25</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_huy" name="Hủy đơn"><bpmn:incoming>f25</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="Task_rep1" name="Xem Bảng kê hóa đơn, cột Đối tác GH hiện Grab Express"><bpmn:incoming>f21</bpmn:incoming><bpmn:outgoing>f26</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_rep2" name="Xem Doanh thu theo đối tác, dòng Grab Express"><bpmn:incoming>f26</bpmn:incoming><bpmn:outgoing>f27</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_ok" name="Kết thúc"><bpmn:incoming>f27</bpmn:incoming></bpmn:endEvent>
