    <bpmn:sequenceFlow id="f9" name="Không" sourceRef="GW_cod" targetRef="End_khac"/>
    <bpmn:sequenceFlow id="f10" name="Có" sourceRef="GW_cod" targetRef="Task_cat"/>
    <bpmn:sequenceFlow id="f11" name="" sourceRef="Task_cat" targetRef="Task_gui"/>
    <bpmn:sequenceFlow id="f12" name="" sourceRef="Task_gui" targetRef="GW_kngui"/>
    <bpmn:sequenceFlow id="f13" name="Không" sourceRef="GW_kngui" targetRef="End_popup"/>
    <bpmn:sequenceFlow id="f14" name="Có" sourceRef="GW_kngui" targetRef="Task_vd"/>
    <bpmn:sequenceFlow id="f15" name="" sourceRef="Task_vd" targetRef="Task_giao"/>
    <bpmn:sequenceFlow id="f16" name="Cập nhật trạng thái" sourceRef="Task_giao" targetRef="Task_theodoi"/>
    <bpmn:sequenceFlow id="f17" name="" sourceRef="Task_theodoi" targetRef="Task_gh"/>
    <bpmn:sequenceFlow id="f18" name="" sourceRef="Task_gh" targetRef="Task_tt"/>
    <bpmn:sequenceFlow id="f19" name="Đơn lên báo cáo" sourceRef="Task_tt" targetRef="Task_rep1"/>
    <bpmn:sequenceFlow id="f20" name="" sourceRef="Task_rep1" targetRef="Task_rep2"/>
    <bpmn:sequenceFlow id="f21" name="" sourceRef="Task_rep2" targetRef="End_ok"/>
  </bpmn:process>
