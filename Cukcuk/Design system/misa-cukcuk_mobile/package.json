    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "typescript": "~5.8.2",
    "tsx": "^4.21.0",
    "esbuild": "^0.25.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/canvas-confetti": "^1.9.0"
