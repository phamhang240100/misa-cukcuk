{
  "name": "misa-cukcuk-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "Cukcuk/[hangpt]-kết-nối-cukcuk---shopeefood-2.0",
    "Cukcuk/[tbhung]_onboarding_pos---v3",
    "Cukcuk/grab-express-integration"
